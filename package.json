{
  "name": "@aside/flags",
  "version": "0.1.1",
  "description": "Provider-neutral boolean feature flags with explicit fallbacks and bounded delivery.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Enry6tz/Flags.git"
  },
  "type": "module",
  "sideEffects": false,
  "engines": { "node": ">=20.9" },
  "files": ["dist", "README.md"],
